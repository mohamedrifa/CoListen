{
  "rules": {
    ".read": false,
    ".write": false,

    "COLISTEN_APP": {
      ".read": true,
      ".write": "auth != null"
    },

    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "roomCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || !newData.exists())"
      }
    },

    "presence": {
      "$roomId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },

    "userInvites": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        "$inviteId": {
          ".write": "auth != null && (auth.uid === $toUid || auth.uid === newData.child('fromUid').val())"
        }
      }
    },

    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('adminId').val() === auth.uid || root.child('rooms/' + $roomId + '/members/' + auth.uid).exists())",

        "members": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms/' + $roomId + '/adminId').val() === auth.uid || root.child('rooms/' + $roomId + '/members/' + auth.uid).exists())"
          }
        },

        "playback": {
          ".write": "auth != null && (root.child('rooms/' + $roomId + '/adminId').val() === auth.uid || root.child('rooms/' + $roomId + '/members/' + auth.uid).exists())"
        },

        "queue": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('rooms/' + $roomId + '/adminId').val() === auth.uid || root.child('rooms/' + $roomId + '/members/' + auth.uid).exists())",
          "$itemId": {
            ".write": "auth != null && (root.child('rooms/' + $roomId + '/adminId').val() === auth.uid || root.child('rooms/' + $roomId + '/members/' + auth.uid).exists() || data.child('addedBy').val() === auth.uid)",
            "upvoteUids": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            },
            "voteSkipUids": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid"
              }
            }
          }
        },

        "reactions": {
          "$reactionId": {
            ".write": "auth != null"
          }
        }
      }
    }
  }
}
